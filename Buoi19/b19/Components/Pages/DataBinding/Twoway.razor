@page "/twoway"
@using System.ComponentModel.DataAnnotations
<PageTitle>Two-way Binding</PageTitle>

@* <input type="text" placeholder="Hay nhap noi dung" @bind="@content" class="from-control w-50" /> *@

<div class="container">
    <div class="row">
        <div class="col-6">
            <h4>Register</h4>
            <EditForm Model="@model">
                <DataAnnotationsValidator /> @* kích hoạt các thuộc tính validation đã khai báo trong model *@
                @* GOM HẾT CÁC LỘI LẠI 1 CHỖ *@
                <ValidationSummary class="text-danger" />
                @* nhiều input đauw các input về model / class
                đăng ký người dùng : email, tên sdt , sở thích , giới tính *@
                <div class="mb-3">
                    <label for="" class="form-label">Name</label>
                    <input type="text" class="form-control" name="" id="" @bind="@model.Name" 
                    @bind:event="oninput" />
                    @* hiển thị lỗi nếu có *@
                    <ValidationMessage class="text-danger" For="@(() => model.Name)" />
                </div>
                <div class="mb-3">
                    <label for="" class="form-label">Email</label>
                    <input type="email" class="form-control" name="" id="" @bind="@model.Email" 
                    @bind:event="oninput" />
                    <ValidationMessage class="text-danger" For="@(() => model.Email)" />
                </div>
                <div class="mb-3">
                    <label for="" class="form-label">SDT</label>
                    <input type="text" class="form-control" name="" id="" @bind="@model.Phone" />
                    <ValidationMessage class="text-danger" For="@(() => model.Phone)" />
                </div>
                <div class="form-group my-2">
                    <lable>Gender</lable>
                    <input id="Male" class="form-check-input" value="true" name="Gender" type="radio" checked
                    @onchange="(e)=> changeGender(true)"/>
                    <label for="Male" class="form-check-label">Male</label>
                    <input id="Female" class="form-check-input" value="false" name="Gender" type="radio"
                    @onchange="(e)=> changeGender(false)"/>
                    <label for="Feale" class="form-check-label">Female</label>
                </div>

                @* hobby *@
                @* <p>Sở thích</p>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" value="1" id="" />
                    <label class="form-check-label" for="">Swimmung</label>
                    <br>
                    <input class="form-check-input" type="checkbox" value="2" id="" />
                    <label class="form-check-label" for="">Running</label>
                    <br>
                    <input class="form-check-input" type="checkbox" value="3" id="" />
                    <label class="form-check-label" for="">Coding</label>
                </div> *@

                @* Hobby *@
                <p>Sở thích</p>
                @foreach (string hobby in lsHobby){
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" value="@hobby" id="@hobby" 
                        @onchange="(e)=> changeHobby(hobby, e.Value)"/>
                        <label class="form-check-label" for="@hobby">@hobby</label>
                    </div>
                }

                @* contry *@
                @* <div class="mb-3">
                    <label for="" class="form-label">Country</label>
                    <select class="form-select form-select-lg" name="" id="">
                        <option selected>Select one</option>
                        <option value="">USA</option>
                        <option value="">Canada</option>
                        <option value="">VietNam</option>~~
                    </select>
                </div> *@


                @*Country*@
                <div class="mb-3">
                    <label for="" class="form-label">Country</label>
                    <select class="form-select form-select-lg" name="" id="" @bind="@model.Country">
                        <option value="">Select one</option>
                        @foreach (var country in lsCountry)
                        {
                            <option value="@country">@country</option>
                        }
                    </select>
                </div>


                <button class="btn btn-primary" type="submit">Submit</button>


            </EditForm>

        </div>

        <div class="col-6">
            <h4>Thông tin vừa nhập</h4>
            <p>UserName: @model.Name</p>
            <p>Email: @model.Email</p>
            <p>FullName: @model.Phone</p>
            <p>Gender: @(model.Gender ? "Male" : "Female" )</p>
            <p>Hobbies: @string.Join(", ", model.Hobby)</p>
            <p>Country: @model.Country</p>
        </div>

    </div>
</div>


@code {
    public string content { get; set; } = "Hellooooooo";


    class RegisterModel
    {
        [EmailAddress(ErrorMessage = "Email không hợp lệ")]
        [Required(ErrorMessage = "Email không được để trống")]
        public string Email { get; set; }

        [Required(ErrorMessage = "Ten không được để trống")]
        public string Name { get; set; }

        [MinLength(9, ErrorMessage = "Số điện thoại phải có ít nhất 9 số")]
        [MaxLength(11, ErrorMessage = "Số điện thoại không được vượt quá 11 số")]
        [RegularExpression(@"^0\d{9,10}$", ErrorMessage = "Số điện thoại không hợp lệ")]
        public string Phone { get; set; }
        public bool Gender { get; set; }
        public List<string> Hobby { get; set; } = new List<string>(); // check box chọn nhiều sở thích
        public string Country { get; set; }
    }

    RegisterModel model = new RegisterModel();

    public List<string> lsHobby = new List<string>(){"Boi", "Da bong", "Cau long", "Chay bo"};

    public List<string> lsCountry = new List<string>(){"USA", "Canada", "VietNam"};    

    public void changeGender(bool value){
        model.Gender = value;
    }

    public void changeHobby(string soThich, object isChecked){
        // nếu isChecked = true thì thêm sở thích vào list 
        if((bool)isChecked){
            model.Hobby.Add(soThich);
        }
        else{
            // nếu isChecked = false thì bỏ sở thích khỏi list
            model.Hobby.Remove(soThich);
        }
    }


}