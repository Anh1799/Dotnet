@page "/baitapxe"



<div class="container">

    <h1>Bai Tap Xe</h1>

    <div class="row">
        <div class="col-6">
            <img width="100%" src="@car.Img" alt="" />
        </div>
        <div class="col-6 flex justify-content-center aligin-items-center">
            @* <button class="btn btn-outline-danger" @onclick='()=>DoiMau("red")'>
                <img width="20px" src="CarBasic/icon-red.jpg" alt="" />Red</button>
            <button class="btn btn-outline-secondary" @onclick='()=>DoiMau("silver")'>
                <img width="20px" src="CarBasic/icon-silver.jpg" alt="" />Silver</button>
            <button class="btn btn-outline-dark" @onclick='()=>DoiMau("black")'>
                <img width="20px" src="CarBasic/icon-black.jpg" alt="" />Black</button>
            <button class="btn btn-outline-info" @onclick='()=>DoiMau("steel")' >
                <img width="20px" src="CarBasic/icon-steel.jpg" alt="" />Steel</button> *@

            @foreach (var car in ds)
            {
                <button class="btn btn-outline-dark" @onclick='()=>DoiMau(car)'>
                    <img width="20px" src="@car.Icon" alt="" />@car.Name</button>
            }    
            
        </div>
    </div>
</div>




@code{

    public class Car
    {
        public string Name {get;set;}
        public string Img {get;set;}
        public string Icon {get;set;}
    }

   // xe hiện tại
    Car car = new Car() { Name = "Black Car", Img = "CarBasic/products/black-car.jpg", Icon = "CarBasic/icons/icon-black.jpg" };

    // danh sách màu xe
    List<Car> ds = new List<Car>(){
        new Car(){Name="Red Car", Img="CarBasic/products/red-car.jpg", Icon="CarBasic/icons/icon-red.jpg"},
        new Car(){Name="Silver Car", Img="CarBasic/products/silver-car.jpg", Icon="CarBasic/icons/icon-silver.jpg"},
        new Car(){Name="Black Car", Img="CarBasic/products/black-car.jpg", Icon="CarBasic/icons/icon-black.jpg"},
        new Car(){Name="Steel Car", Img="CarBasic/products/steel-car.jpg", Icon="CarBasic/icons/icon-steel.jpg"},
    };


    string color ="black";


    void DoiMau(Car xe)
    {
        car = xe;
    }
}