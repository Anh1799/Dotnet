@page "/counter"

<PageTitle>Counter</PageTitle>

@* <h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button> *@

<div class="card col-5"/>
     <img src="https://picsum.photos/200/300" height="300px" alt="">
    <div class="card-body">
        <h4 class="card-title">Justin</h4>
        <p class="card-text">20 years old</p>
    </div>
    <div class="card-footer">
        <button class="btn btn-warning" @onclick="()=>TangGiam(-1)">Dislike</button>
        @count
        <button class="btn btn-info" @onclick="()=>TangGiam(1)">Like</button>
    </div>

@code {
    @* private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    } *@

    int count = 20;
    void Tang()
    {
        count++;
    }

    void Giam()
    {
        count--;
    }

    // increase +1 decrease -1
    void TangGiam(int x)
    {
        count += x;
    }


}
