@page "/dang-ky"
@using HealthCheck.Models
@using HealthCheck.Services
@inject HealthDataStore Store
@inject NavigationManager Nav

<PageTitle>Đăng ký tài khoản</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h3 class="mb-3">Tạo tài khoản</h3>

                <EditForm Model="model" OnValidSubmit="HandleRegister" FormName="register">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <InputText @bind-Value="model.Email" class="form-control" placeholder="ban@example.com" />
                        <ValidationMessage For="() => model.Email" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mật khẩu</label>
                        <InputText type="password" @bind-Value="model.Password" class="form-control" />
                        <ValidationMessage For="() => model.Password" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Nhập lại mật khẩu</label>
                        <InputText type="password" @bind-Value="model.ConfirmPassword" class="form-control" />
                        <ValidationMessage For="() => model.ConfirmPassword" />
                    </div>

                    @if (error != null)
                    {
                        <div class="alert alert-danger py-2">@error</div>
                    }

                    <button type="submit" class="btn btn-primary w-100">Đăng ký</button>
                </EditForm>

                <p class="mt-3 mb-0 text-center">
                    Đã có tài khoản? <a href="dang-nhap">Đăng nhập</a>
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    private RegisterModel model = new();
    private string? error;

    private void HandleRegister()
    {
        var (ok, err) = Store.Register(model.Email, model.Password);
        if (!ok) { error = err; return; }

        Nav.NavigateTo("dang-nhap?registered=1");
    }
}
